# =========================
# DeepSeek API 配置
# =========================

# 必填：DeepSeek API Key
# 例如：sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# 可选：DeepSeek 兼容接口地址
# 官方一般填写：https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名称
# 默认推荐：deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash


# =========================
# SMTP 邮件发送配置
# =========================

# 必填：SMTP 服务器地址
# 例如：
# - QQ 邮箱：smtp.qq.com
# - Gmail：smtp.gmail.com
SMTP_HOST=smtp.qq.com

# 必填：SMTP 端口
# 常见：
# - QQ 邮箱 SSL：465
# - Gmail TLS：587
SMTP_PORT=465

# 必填：发件邮箱账号
# 例如：yourname@qq.com
SMTP_USER=

# 必填：SMTP 授权码或 SMTP 专用密码
# 注意：很多邮箱这里不是网页登录密码，而是单独生成的 SMTP 授权码
SMTP_PASSWORD=

# 必填：发件人邮箱地址
# 通常与 SMTP_USER 相同
MAIL_FROM=

# 必填：收件人邮箱
# 多个收件人请用英文逗号分隔
# 例如：a@example.com,b@example.com
MAIL_TO=
